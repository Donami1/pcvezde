# ---- База данных (SQLite, шифруется через SQLCipher) ----
# Путь к файлу БД относительно корня проекта
DATABASE_FILE="./data/pcvezde.db"

# ---- Секреты ----
# Все секреты можно НЕ задавать: при первом запуске они автоматически
# генерируются и сохраняются в data/secrets.json (режим 600, вне git).
# ENV-переменные ниже — опциональные ОБЯЗАТЕЛЬНЫЕ-для-продакшена overrides.
#
# AUTH_SECRET — секрет для подписи JWT-сессий и ключ шифрования ПДн (HKDF).
# Пустой/отсутствующий в prod — сгенерируется автоматически.
AUTH_SECRET=""
#
# DATABASE_ENCRYPTION_KEY — ключ SQLCipher для файла БД (hex, 64 символа).
# Пустой/отсутствующий в prod — сгенерируется автоматически.
# ВНИМАНИЕ: если ключ уже записан в data/secrets.json, смена ключа сюда
# сделает существующий файл БД нечитаемым — ключ нужно использовать один и тот же.
DATABASE_ENCRYPTION_KEY=""
#
# ADMIN_PASSWORD — пароль админки /admin.
# Если не задан:
#   dev  -> используется dev-пароль "admin123"
#   prod -> генерируется случайный пароль при первом запуске (пишется в консоль).
# Можно также сразу задать bcrypt-хэш (начинается с $2a$/$2b$/$2y$).
ADMIN_PASSWORD=""

# Telegram-уведомления о заявках
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=""
# Chat ID, куда слать заявки (узнать: напишите боту /start, затем https://api.telegram.org/bot<ТОКЕН>/getUpdates)
TELEGRAM_CHAT_ID=""

# ---- Карты для выбора адреса в форме заявки (необязательно) ----
# Если ключи пустые — остаётся обычное текстовое поле адреса.
# Яндекс: https://developer.tech.yandex.ru/services (продукт «JavaScript API и HTTP-геокодер»)
# 2ГИС:   https://catalog.api.2gis.com (ключ web-gis / API-key)
NEXT_PUBLIC_YANDEX_MAPS_KEY=""
NEXT_PUBLIC_2GIS_KEY=""

# ---- Контакты (показываются в шапке/подвале/контактах) ----
NEXT_PUBLIC_PHONE="+7 (999) 123-45-67"
NEXT_PUBLIC_PHONE_HREF="+79991234567"
NEXT_PUBLIC_TELEGRAM="https://t.me/your_username"
NEXT_PUBLIC_WHATSAPP="https://wa.me/79991234567"
NEXT_PUBLIC_CITY="Москва"